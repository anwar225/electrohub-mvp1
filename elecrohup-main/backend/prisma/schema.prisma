datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nom          String
  role         String   @default("vendeur")
  createdAt    DateTime @default(now())

  factures Facture[]
  produits Produit[]

  @@map("users")
}

model Facture {
  id            Int      @id @default(autoincrement())
  numero        String   @unique
  date          DateTime
  type          String
  fournisseurNom String?
  clientNom     String?
  montantTotal  Float    @default(0)
  imageUrl      String?
  status        String   @default("draft")
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  items         FactureItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("factures")
}

model FactureItem {
  id           Int      @id @default(autoincrement())
  facture      Facture  @relation(fields: [factureId], references: [id], onDelete: Cascade)
  factureId    Int
  produit      Produit  @relation(fields: [produitId], references: [id])
  produitId    Int
  designation  String
  quantite     Int
  prixUnitaire Float
  montantTotal Float    @default(0)
  createdAt    DateTime @default(now())

  @@map("facture_items")
}

model Produit {
  id          Int      @id @default(autoincrement())
  nom         String
  reference   String   @unique
  categorie   String   @default("Général")
  prixAchat   Float
  prixVente   Float
  stockActuel Int      @default(0)
  stockMin    Int      @default(5)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  factureItems FactureItem[]
  movements    StockMovement[]

  @@map("produits")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  produit   Produit  @relation(fields: [produitId], references: [id])
  produitId Int
  type      String
  quantite  Int
  factureId Int?
  createdAt DateTime @default(now())

  @@map("stock_movements")
}
